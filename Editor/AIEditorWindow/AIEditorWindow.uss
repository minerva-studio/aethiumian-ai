.ai-editor-shell {
    flex-grow: 1;
    flex-direction: column;
}

.ai-editor-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ai-editor-toolbar-left,
.ai-editor-toolbar-right {
    flex-direction: row;
    align-items: center;
}

.ai-editor-toolbar-right {
    flex-shrink: 0;
}

.ai-editor-toolbar-spacer {
    flex-grow: 1;
}

.ai-editor-upgrade-button {
    display: none;
}

.ai-editor-tree-selection {
    flex-shrink: 0;
    flex-direction: row;
}

.ai-editor-tree-field {
    flex-grow: 1;
    min-width: 220px;
}

.ai-editor-content-host {
    flex-grow: 1;
    flex-direction: column;
}

.ai-editor-graph-host {
    flex-grow: 1;
    flex-direction: column;
    display: none;
}

.ai-editor-imgui-pane {
    flex-grow: 1;
}

.ai-editor-lock-toggle {
    width: 24px;
    min-width: 24px;
    max-width: 24px;
    padding-left: 2px;
    padding-right: 2px;
    justify-content: center;
    align-items: center;
}

.ai-editor-lock-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.ai-editor-graph-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
    background-color: rgb(32, 32, 32);
}

.ai-editor-graph-canvas-host {
    flex-grow: 1;
    min-width: 0;
}

.ai-editor-graph-canvas {
    flex-grow: 1;
    min-width: 0;
    background-color: rgb(32, 32, 32);
    --graph-grid-dark: rgba(255, 255, 255, 0.045);
    --graph-grid-light: rgba(0, 0, 0, 0.055);
    --graph-node-normal-fill-dark: rgba(41, 43, 48, 0.98);
    --graph-node-normal-fill-light: rgba(209, 212, 217, 0.98);
    --graph-leaf-boolean-fill-dark: rgba(56, 56, 117, 0.98);
    --graph-leaf-boolean-fill-light: rgba(173, 179, 242, 0.98);
    --graph-leaf-boolean-stroke: rgb(125, 133, 245);
    --graph-leaf-constant-true-fill-dark: rgba(41, 102, 61, 0.98);
    --graph-leaf-constant-true-fill-light: rgba(158, 224, 173, 0.98);
    --graph-leaf-constant-true-stroke: rgb(97, 219, 133);
    --graph-leaf-constant-false-fill-dark: rgba(112, 46, 51, 0.98);
    --graph-leaf-constant-false-fill-light: rgba(240, 168, 173, 0.98);
    --graph-leaf-constant-false-stroke: rgb(240, 102, 107);
    --graph-node-flow-fill-dark: rgba(31, 61, 79, 0.98);
    --graph-node-flow-fill-light: rgba(184, 219, 232, 0.98);
    --graph-node-branch-fill-dark: rgba(64, 46, 79, 0.98);
    --graph-node-branch-fill-light: rgba(217, 199, 232, 0.98);
    --graph-node-service-fill-dark: rgba(77, 59, 26, 0.98);
    --graph-node-service-fill-light: rgba(237, 219, 173, 0.98);
    --graph-condition-fill-dark: rgba(31, 26, 41, 0.7);
    --graph-condition-fill-light: rgba(224, 214, 235, 0.7);
    --graph-family-sequence-fill-dark: rgba(64, 184, 235, 0.22);
    --graph-family-sequence-fill-light: rgba(64, 184, 235, 0.14);
    --graph-family-loop-fill-dark: rgba(71, 209, 184, 0.22);
    --graph-family-loop-fill-light: rgba(71, 209, 184, 0.14);
    --graph-family-condition-fill-dark: rgba(184, 122, 235, 0.12);
    --graph-family-condition-fill-light: rgba(184, 122, 235, 0.08);
    --graph-family-decision-fill-dark: rgba(126, 138, 242, 0.22);
    --graph-family-decision-fill-light: rgba(126, 138, 242, 0.14);
    --graph-family-probability-fill-dark: rgba(232, 111, 154, 0.22);
    --graph-family-probability-fill-light: rgba(232, 111, 154, 0.14);
    --graph-family-parallel-fill-dark: rgba(89, 168, 242, 0.22);
    --graph-family-parallel-fill-light: rgba(89, 168, 242, 0.14);
    --graph-family-sequence-stroke: rgb(64, 184, 235);
    --graph-family-loop-stroke: rgb(71, 209, 184);
    --graph-family-condition-stroke: rgb(184, 122, 235);
    --graph-family-decision-stroke: rgb(126, 138, 242);
    --graph-family-probability-stroke: rgb(232, 111, 154);
    --graph-family-parallel-stroke: rgb(89, 168, 242);
    --graph-compound-fill-dark: rgba(26, 31, 38, 0.96);
    --graph-compound-fill-light: rgba(224, 230, 237, 0.96);
    --graph-node-normal-stroke-dark: rgba(158, 166, 179, 0.9);
    --graph-node-normal-stroke-light: rgba(82, 89, 102, 0.9);
    --graph-node-flow-stroke: rgba(64, 171, 209, 0.95);
    --graph-node-branch-stroke: rgba(173, 115, 219, 0.95);
    --graph-node-service-stroke: rgba(232, 168, 54, 0.95);
    --graph-node-selected-stroke: rgb(64, 158, 255);
    --graph-node-warning-stroke: rgba(255, 122, 64, 0.95);
    --graph-edge-structural: rgb(184, 184, 184);
    --graph-edge-service: rgb(242, 184, 64);
    --graph-edge-raw: rgb(140, 166, 230);
    --graph-edge-flow: rgb(64, 184, 235);
    --graph-edge-branch: rgb(184, 122, 235);
    --graph-edge-probability: rgb(232, 111, 154);
    --graph-edge-parallel: rgb(89, 168, 242);
    --graph-edge-loop: rgb(71, 209, 184);
    --graph-boundary-entrance: rgb(45, 212, 191);
    --graph-boundary-exit: rgb(255, 122, 110);
    --graph-scope-sequence: rgba(64, 184, 235, 0.42);
    --graph-scope-sequence-selected: rgba(64, 158, 255, 0.9);
    --graph-scope-condition: rgba(184, 122, 235, 0.38);
    --graph-scope-condition-selected: rgba(184, 122, 235, 0.95);
    --graph-scope-probability: rgba(232, 111, 154, 0.32);
    --graph-scope-probability-selected: rgba(232, 111, 154, 0.9);
    --graph-grid-line-width: 1;
    --graph-node-line-width: 1.5;
    --graph-selected-line-width: 2.5;
    --graph-scope-line-width: 1.25;
    --graph-scope-selected-line-width: 2;
    --graph-edge-authored-line-width: 2;
    --graph-edge-derived-line-width: 1.25;
    --graph-edge-placeholder-line-width: 1;
    --graph-edge-derived-mark-length: 8;
    --graph-edge-derived-gap-length: 5;
    --graph-edge-control-mark-length: 4;
    --graph-edge-control-gap-length: 4;
    --graph-edge-placeholder-mark-length: 2;
    --graph-edge-placeholder-gap-length: 6;
    --graph-edge-disabled-alpha: 0.32;
}

.ai-editor-graph-view-options-group {
    position: absolute;
    top: 10px;
    left: 10px;
}

.ai-editor-graph-view-options,
.ai-editor-graph-visibility-options {
    align-items: center;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(46, 46, 46, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(105, 112, 125, 0.65);
    border-right-color: rgba(105, 112, 125, 0.65);
    border-top-color: rgba(105, 112, 125, 0.65);
    border-bottom-color: rgba(105, 112, 125, 0.65);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.ai-editor-graph-visibility-options {
    margin-top: 6px;
}

.ai-editor-graph-visibility-options > .ai-editor-graph-view-options-button {
    display: flex;
}

.ai-editor-graph-view-options-button {
    display: none;
    justify-content: center;
    align-items: center;
    width: 30px;
    height: 30px;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 1px;
    margin-bottom: 1px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(198, 202, 208);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 17px;
    -unity-text-align: middle-center;
}

.ai-editor-graph-view-options-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    -unity-image-tint-color: rgb(198, 202, 208);
}

.ai-editor-graph-view-options-button:hover {
    background-color: rgba(135, 145, 158, 0.35);
}

.ai-editor-graph-view-options-button:active,
.ai-editor-graph-view-options-button-active {
    background-color: rgba(87, 137, 184, 0.72);
    color: rgb(238, 244, 250);
}

.ai-editor-graph-view-options-button-active > .ai-editor-graph-view-options-icon {
    -unity-image-tint-color: rgb(238, 244, 250);
}

.ai-editor-graph-view-options > #ai-editor-graph-view-options-expand {
    display: flex;
}

.ai-editor-graph-view-options-expanded > .ai-editor-graph-view-options-button {
    display: flex;
}

.ai-editor-graph-content,
.ai-editor-graph-node-layer,
.ai-editor-graph-edge-layer {
    overflow: visible;
}

.ai-editor-graph-content {
    transform-origin: 0 0;
}

.ai-editor-graph-creation-overlay {
    background-color: rgba(0, 0, 0, 0);
}

.ai-editor-graph-node-creation-palette {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: var(--graph-compound-fill-dark);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--graph-node-normal-stroke-dark);
    border-right-color: var(--graph-node-normal-stroke-dark);
    border-top-color: var(--graph-node-normal-stroke-dark);
    border-bottom-color: var(--graph-node-normal-stroke-dark);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.ai-editor-graph-node-creation-search {
    margin-bottom: 4px;
}

.ai-editor-graph-node-creation-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.ai-editor-graph-node-creation-header-slot {
    width: 32px;
    min-width: 32px;
    flex-shrink: 0;
    align-items: center;
}

.ai-editor-graph-node-creation-back {
    width: 28px;
    min-width: 28px;
}

.ai-editor-graph-node-creation-title {
    min-width: 0;
    flex-grow: 1;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ai-editor-graph-node-creation-results {
    flex-grow: 1;
    min-height: 0;
}

.ai-editor-graph-node-creation-row {
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    margin-bottom: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.ai-editor-graph-node-creation-row:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.ai-editor-graph-node-creation-row-marker {
    width: 16px;
    min-width: 16px;
    color: var(--graph-node-selected-stroke);
    -unity-text-align: middle-center;
}

.ai-editor-graph-node-creation-row-text {
    flex-grow: 1;
    overflow: hidden;
}

.ai-editor-graph-node-creation-row-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ai-editor-graph-node-creation-detail {
    height: 34px;
    min-height: 34px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.7;
}

.ai-editor-graph-node-creation-row-detail {
    display: none;
}

.ai-editor-graph-node-creation-row-selected {
    background-color: rgba(80, 140, 220, 0.24);
    border-left-color: var(--graph-node-selected-stroke);
    border-right-color: var(--graph-node-selected-stroke);
    border-top-color: var(--graph-node-selected-stroke);
    border-bottom-color: var(--graph-node-selected-stroke);
}

.ai-editor-graph-node-creation-empty {
    unity-text-align: middle-center;
    opacity: 0.65;
}


.ai-editor-graph-inspector-splitter {
    width: 5px;
    min-width: 5px;
    max-width: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(128, 128, 128, 0.35);
    border-right-color: rgba(128, 128, 128, 0.35);
}

.ai-editor-graph-inspector {
    flex-shrink: 0;
    min-width: 220px;
    max-width: 620px;
    flex-direction: column;
    background-color: rgb(46, 46, 46);
}

.ai-editor-graph-inspector-content {
    flex-grow: 1;
}

.ai-editor-graph-inspector-imgui {
    flex-grow: 1;
}

.ai-editor-graph-node {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    justify-content: center;
    align-items: center;
}

.ai-editor-graph-node-flow {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.ai-editor-graph-node-branch {
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 8px;
    padding-bottom: 8px;
    align-items: center;
}

.ai-editor-graph-node-service {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.ai-editor-graph-node-compact {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
}

.ai-editor-graph-node-decorator {
    padding-left: 8px;
    padding-right: 8px;
}

.ai-editor-graph-node-boolean {
    padding-left: 8px;
    padding-right: 8px;
}

.ai-editor-graph-node-constant {
    padding-left: 4px;
    padding-right: 4px;
}

.ai-editor-graph-node-compact .ai-editor-graph-node-title {
    font-size: 9px;
}

.ai-editor-graph-node-head {
    opacity: 1;
}

.ai-editor-graph-node-unreachable {
    opacity: 0.65;
}

.ai-editor-graph-node-title {
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    max-width: 100%;
    min-width: 0;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.ai-editor-graph-node-type {
    font-size: 10px;
    opacity: 0.72;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    max-width: 100%;
    min-width: 0;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.ai-editor-graph-node-warning {
    position: absolute;
    right: 8px;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgb(210, 75, 45);
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ai-editor-graph-boundary {
    justify-content: center;
    align-items: center;
}

.ai-editor-graph-boundary-title {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.ai-editor-graph-boundary-subtitle {
    font-size: 9px;
    opacity: 0.68;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.ai-editor-graph-condition-check {
    position: absolute;
    top: 16px;
    left: 0;
    right: 0;
    font-size: 8px;
    opacity: 0.76;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ai-editor-graph-condition-check-missing {
    color: rgb(235, 126, 96);
}

.ai-editor-graph-decorator-badge .ai-editor-graph-node-title {
    font-size: 8px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-left: 3px;
    padding-right: 3px;
}

.ai-editor-graph-edge-label {
    font-size: 9px;
    margin-left: 3px;
    margin-top: -7px;
    opacity: 0.78;
}

.ai-editor-graph-edge-label-disabled {
    opacity: 0.34;
}

.ai-editor-graph-sequence-scope {
    position: absolute;
    overflow: visible;
}

.ai-editor-graph-condition-scope {
    position: absolute;
    overflow: visible;
}

.ai-editor-graph-probability-scope {
    position: absolute;
    overflow: visible;
}

.ai-editor-graph-service-scope {
    position: absolute;
    overflow: visible;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(219, 154, 34, 0.55);
    border-right-color: rgba(219, 154, 34, 0.55);
    border-top-color: rgba(219, 154, 34, 0.55);
    border-bottom-color: rgba(219, 154, 34, 0.55);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.ai-editor-graph-service-scope-selected {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 183, 50);
    border-right-color: rgb(255, 183, 50);
    border-top-color: rgb(255, 183, 50);
    border-bottom-color: rgb(255, 183, 50);
}

.ai-editor-graph-service-scope-header {
    position: absolute;
    left: 8px;
    right: 5px;
    top: 2px;
    height: 18px;
    flex-direction: row;
    align-items: center;
    color: rgb(218, 166, 73);
    font-size: 9px;
    -unity-text-align: middle-left;
}

.ai-editor-graph-service-scope-title {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.ai-editor-graph-service-follow {
    width: 18px;
    min-width: 18px;
    height: 16px;
    min-height: 16px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 2px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 9px;
    -unity-text-align: middle-center;
}

.ai-editor-graph-service-placeholder {
    position: absolute;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(219, 154, 34, 0.65);
    border-right-color: rgba(219, 154, 34, 0.65);
    border-top-color: rgba(219, 154, 34, 0.65);
    border-bottom-color: rgba(219, 154, 34, 0.65);
    background-color: rgba(91, 65, 24, 0.28);
    opacity: 0.78;
    padding-left: 9px;
    padding-right: 9px;
}

.ai-editor-graph-service-placeholder-title {
    flex-grow: 1;
    color: rgb(218, 166, 73);
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.ai-editor-graph-loop-body-frame {
    position: absolute;
    overflow: visible;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(72, 210, 184, 0.28);
    border-right-color: rgba(72, 210, 184, 0.28);
    border-top-color: rgba(72, 210, 184, 0.28);
    border-bottom-color: rgba(72, 210, 184, 0.28);
    border-radius: 7px;
    background-color: rgba(72, 210, 184, 0.025);
}

.ai-editor-graph-loop-body-frame-selected {
    border-left-color: rgba(72, 210, 184, 0.8);
    border-right-color: rgba(72, 210, 184, 0.8);
    border-top-color: rgba(72, 210, 184, 0.8);
    border-bottom-color: rgba(72, 210, 184, 0.8);
    background-color: rgba(72, 210, 184, 0.055);
}

.ai-editor-graph-loop-body-frame-label {
    position: absolute;
    left: 8px;
    top: 2px;
    font-size: 8px;
    opacity: 0.58;
    color: rgb(72, 210, 184);
    white-space: nowrap;
}

.ai-editor-graph-flow-end {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(64, 184, 235, 0.72);
    border-right-color: rgba(64, 184, 235, 0.72);
    border-top-color: rgba(64, 184, 235, 0.72);
    border-bottom-color: rgba(64, 184, 235, 0.72);
    border-radius: 12px;
    background-color: rgba(64, 184, 235, 0.12);
    font-size: 9px;
    padding-left: 10px;
    padding-right: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ai-editor-graph-flow-end-selected {
    border-left-color: rgb(64, 158, 255);
    border-right-color: rgb(64, 158, 255);
    border-top-color: rgb(64, 158, 255);
    border-bottom-color: rgb(64, 158, 255);
}

.ai-editor-graph-flow-end-condition {
    border-left-color: rgba(184, 122, 235, 0.72);
    border-right-color: rgba(184, 122, 235, 0.72);
    border-top-color: rgba(184, 122, 235, 0.72);
    border-bottom-color: rgba(184, 122, 235, 0.72);
    background-color: rgba(184, 122, 235, 0.12);
}

.ai-editor-graph-flow-end-decision {
    border-left-color: rgba(126, 138, 242, 0.72);
    border-right-color: rgba(126, 138, 242, 0.72);
    border-top-color: rgba(126, 138, 242, 0.72);
    border-bottom-color: rgba(126, 138, 242, 0.72);
    background-color: rgba(126, 138, 242, 0.12);
}

