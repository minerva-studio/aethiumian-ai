.ai-editor-shell {
    flex-grow: 1;
    flex-direction: column;
}

.ai-editor-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ai-editor-toolbar-left,
.ai-editor-toolbar-right {
    flex-direction: row;
    align-items: center;
}

.ai-editor-toolbar-right {
    flex-shrink: 0;
}

.ai-editor-toolbar-spacer {
    flex-grow: 1;
}

.ai-editor-upgrade-button {
    display: none;
}

.ai-editor-tree-selection {
    flex-shrink: 0;
    flex-direction: row;
}

.ai-editor-tree-field {
    flex-grow: 1;
    min-width: 220px;
}

.ai-editor-content-host {
    flex-grow: 1;
    flex-direction: column;
}

.ai-editor-graph-host {
    flex-grow: 1;
    flex-direction: column;
    display: none;
}

.ai-editor-imgui-pane {
    flex-grow: 1;
}

.ai-editor-lock-toggle {
    width: 24px;
    min-width: 24px;
    max-width: 24px;
    padding-left: 2px;
    padding-right: 2px;
    justify-content: center;
    align-items: center;
}

.ai-editor-lock-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.ai-editor-graph-toolbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    min-height: 22px;
}

.ai-editor-graph-toolbar-spacer {
    flex-grow: 1;
}

.ai-editor-graph-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.ai-editor-graph-canvas {
    flex-grow: 1;
    min-width: 0;
}

.ai-editor-graph-content,
.ai-editor-graph-node-layer,
.ai-editor-graph-edge-layer {
    overflow: visible;
}

.ai-editor-graph-content {
    transform-origin: 0 0;
}

.ai-editor-graph-inspector-splitter {
    width: 5px;
    min-width: 5px;
    max-width: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(128, 128, 128, 0.35);
    border-right-color: rgba(128, 128, 128, 0.35);
}

.ai-editor-graph-inspector {
    flex-shrink: 0;
    min-width: 220px;
    max-width: 620px;
    flex-direction: column;
}

.ai-editor-graph-inspector-imgui {
    flex-grow: 1;
}

.ai-editor-graph-node {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 6px;
    justify-content: center;
}

.ai-editor-graph-node-flow {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 5px;
    padding-bottom: 4px;
}

.ai-editor-graph-node-branch {
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 9px;
    padding-bottom: 8px;
    align-items: center;
}

.ai-editor-graph-node-service {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 4px;
    padding-bottom: 3px;
}

.ai-editor-graph-node-head {
    opacity: 1;
}

.ai-editor-graph-node-unreachable {
    opacity: 0.65;
}

.ai-editor-graph-node-title {
    -unity-font-style: bold;
    overflow: hidden;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.ai-editor-graph-node-type {
    font-size: 10px;
    opacity: 0.72;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.ai-editor-graph-node-warning {
    position: absolute;
    right: 8px;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgb(210, 75, 45);
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ai-editor-graph-edge-label {
    font-size: 9px;
    margin-left: 3px;
    margin-top: -7px;
    opacity: 0.78;
}

.ai-editor-graph-sequence-scope {
    position: absolute;
    overflow: visible;
}

.ai-editor-graph-condition-scope {
    position: absolute;
    overflow: visible;
}

.ai-editor-graph-loop-body-frame {
    position: absolute;
    overflow: visible;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(72, 210, 184, 0.28);
    border-right-color: rgba(72, 210, 184, 0.28);
    border-top-color: rgba(72, 210, 184, 0.28);
    border-bottom-color: rgba(72, 210, 184, 0.28);
    border-radius: 7px;
    background-color: rgba(72, 210, 184, 0.025);
}

.ai-editor-graph-loop-body-frame-selected {
    border-left-color: rgba(72, 210, 184, 0.8);
    border-right-color: rgba(72, 210, 184, 0.8);
    border-top-color: rgba(72, 210, 184, 0.8);
    border-bottom-color: rgba(72, 210, 184, 0.8);
    background-color: rgba(72, 210, 184, 0.055);
}

.ai-editor-graph-loop-body-frame-label {
    position: absolute;
    left: 8px;
    top: 2px;
    font-size: 8px;
    opacity: 0.58;
    color: rgb(72, 210, 184);
    white-space: nowrap;
}

.ai-editor-graph-flow-end {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(64, 184, 235, 0.72);
    border-right-color: rgba(64, 184, 235, 0.72);
    border-top-color: rgba(64, 184, 235, 0.72);
    border-bottom-color: rgba(64, 184, 235, 0.72);
    border-radius: 12px;
    background-color: rgba(64, 184, 235, 0.12);
    font-size: 9px;
    padding-left: 10px;
    padding-right: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ai-editor-graph-flow-end-selected {
    border-left-color: rgb(64, 158, 255);
    border-right-color: rgb(64, 158, 255);
    border-top-color: rgb(64, 158, 255);
    border-bottom-color: rgb(64, 158, 255);
}

.ai-editor-graph-condition-placeholder {
    position: absolute;
    justify-content: center;
    padding-left: 10px;
    padding-right: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(184, 122, 235, 0.52);
    border-right-color: rgba(184, 122, 235, 0.52);
    border-top-color: rgba(184, 122, 235, 0.52);
    border-bottom-color: rgba(184, 122, 235, 0.52);
    border-radius: 8px;
    background-color: rgba(184, 122, 235, 0.08);
}

.ai-editor-graph-condition-placeholder-missing {
    border-left-color: rgba(235, 126, 96, 0.72);
    border-right-color: rgba(235, 126, 96, 0.72);
    border-top-color: rgba(235, 126, 96, 0.72);
    border-bottom-color: rgba(235, 126, 96, 0.72);
}

.ai-editor-graph-condition-placeholder-title {
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ai-editor-graph-condition-placeholder-subtitle {
    margin-top: 1px;
    font-size: 9px;
    opacity: 0.72;
    -unity-text-align: middle-center;
}

.ai-editor-graph-loop-placeholder {
    position: absolute;
    justify-content: center;
    padding-left: 10px;
    padding-right: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(72, 210, 184, 0.52);
    border-right-color: rgba(72, 210, 184, 0.52);
    border-top-color: rgba(72, 210, 184, 0.52);
    border-bottom-color: rgba(72, 210, 184, 0.52);
    border-radius: 8px;
    background-color: rgba(72, 210, 184, 0.08);
}

.ai-editor-graph-loop-placeholder-missing {
    border-left-color: rgba(235, 126, 96, 0.72);
    border-right-color: rgba(235, 126, 96, 0.72);
    border-top-color: rgba(235, 126, 96, 0.72);
    border-bottom-color: rgba(235, 126, 96, 0.72);
}

.ai-editor-graph-loop-placeholder-title {
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ai-editor-graph-loop-placeholder-subtitle {
    margin-top: 1px;
    font-size: 9px;
    opacity: 0.72;
    -unity-text-align: middle-center;
}

.ai-editor-graph-loop-junction {
    position: absolute;
    justify-content: center;
    padding-left: 10px;
    padding-right: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(72, 210, 184, 0.68);
    border-right-color: rgba(72, 210, 184, 0.68);
    border-top-color: rgba(72, 210, 184, 0.68);
    border-bottom-color: rgba(72, 210, 184, 0.68);
    border-radius: 11px;
    background-color: rgba(72, 210, 184, 0.11);
}

.ai-editor-graph-loop-junction-title {
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ai-editor-graph-loop-junction-subtitle {
    margin-top: 1px;
    font-size: 8px;
    opacity: 0.7;
    -unity-text-align: middle-center;
}

.ai-editor-graph-condition {
    overflow: visible;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
}

.ai-editor-graph-condition-title {
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.ai-editor-graph-condition-type {
    font-size: 10px;
    opacity: 0.72;
    white-space: nowrap;
    overflow: hidden;
}

.ai-editor-graph-condition-selected {
    opacity: 1;
}

.ai-editor-graph-container {
    position: absolute;
    overflow: visible;
    padding: 0;
}

.ai-editor-graph-container-header {
    flex-direction: column;
    justify-content: center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 3px;
}

.ai-editor-graph-container-title {
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.ai-editor-graph-container-type {
    font-size: 10px;
    opacity: 0.72;
    white-space: nowrap;
    overflow: hidden;
}

.ai-editor-graph-container-selected {
    opacity: 1;
}

.ai-editor-graph-slot {
    position: absolute;
    overflow: visible;
}

.ai-editor-graph-slot-label {
    font-size: 10px;
    opacity: 0.78;
    white-space: nowrap;
}

.ai-editor-graph-reference {
    position: absolute;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    justify-content: center;
    border-width: 1px;
    border-radius: 5px;
}

.ai-editor-graph-reference-missing {
    border-color: rgb(210, 75, 45);
    background-color: rgba(210, 75, 45, 0.16);
}

.ai-editor-graph-reference-proxy {
    border-color: rgba(210, 160, 65, 0.9);
    background-color: rgba(210, 160, 65, 0.12);
}

.ai-editor-graph-reference-selected {
    border-color: rgb(80, 160, 255);
}

.ai-editor-graph-reference-title {
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
}

.ai-editor-shell.ai-editor-compact .ai-editor-toolbar-left > *,
.ai-editor-shell.ai-editor-compact .ai-editor-toolbar-right > * {
    margin-left: 1px;
    margin-right: 1px;
}

.ai-editor-shell.ai-editor-compact .ai-editor-tree-field {
    min-width: 160px;
}
